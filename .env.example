# Screenshot extraction order: Qwen is primary, OpenAI is the quality fallback.
VISION_PROVIDER_ORDER=qwen,openai
VISION_TIMEOUT_MS=20000
VISION_FALLBACK_TIMEOUT_MS=20000
VISION_MAX_OUTPUT_TOKENS=1200

# Qwen3.6-Flash on Alibaba Cloud Model Studio (Singapore / International).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.6-flash

# OpenAI is called only when Qwen is unavailable, invalid, or low-confidence.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.4-mini

# Enables real restaurant candidate search and confirmed-place detail refresh.
GOOGLE_MAPS_API_KEY=

# Optional enrichment for Hot Pepper listing, hours, closed days, and budget.
HOTPEPPER_API_KEY=

# Local development port.
PORT=4173

# Set true only behind a trusted reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=false

# Shared code for a closed production pilot. Local development may leave it blank.
PILOT_ACCESS_CODE=
# Production is fail-closed unless either a pilot code is set or public mode is explicitly enabled after the public-release gate.
PUBLIC_RELEASE_MODE=false
PAID_API_EMERGENCY_STOP=false

# Public legal/contact information shown on /privacy and /terms; required in production.
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=

# Privacy-minimized event and provider metric JSONL retention.
LOG_RETENTION_DAYS=30
EVENT_LOG_MAX_LINES=50000
EVENT_LOG_MAX_BYTES=10485760
SOURCE_LOG_MAX_LINES=50000
SOURCE_LOG_MAX_BYTES=10485760

# Application-side daily safety caps. Keep these below provider-console hard quotas.
DAILY_VISION_REQUEST_LIMIT=60
DAILY_QWEN_ATTEMPT_LIMIT=60
DAILY_OPENAI_FALLBACK_LIMIT=10
DAILY_PLACES_SEARCH_LIMIT=90
DAILY_PLACES_DETAILS_LIMIT=90
DAILY_HOTPEPPER_ATTEMPT_LIMIT=60
